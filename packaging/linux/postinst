#!/bin/sh
# Debian/.deb maintainer postinst — Vance.
#
# Deliberately does NOT auto-install the optional AI tools. A .deb postinst runs
# as ROOT during `apt install`, but Vance's managed tools dir is PER-USER
# (~/.config/Vance/tools), so installing them here would put them in root's home
# and pull hundreds of MB during a system package install — both wrong.
#
# On Linux the AI-tools prompt is the app's FIRST-RUN onboarding step (runs as
# the user), and the always-available in-app "AI tools" panel adds them later.
# Both call the same headless primitive a power user can run by hand:
#
#     vance-app --install-ai-tools all      # all four
#     vance-app --install-ai-tools whisper  # or a subset
#     vance-app --list-ai-tools             # catalog
#
set -e

case "$1" in
  configure)
    # Refresh desktop/icon caches if present; never fatal.
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q || true
    ;;
esac

exit 0
