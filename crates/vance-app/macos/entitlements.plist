<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS hardened-runtime entitlements for the signed/notarized Vance bundle.

  Vance is unusual: it loads THIRD-PARTY, independently-signed (often unsigned)
  audio/video plugins out of process — CLAP + LV2 via `vance-plugin-host`, OpenFX
  via `vance-ofx-host` — by dlopen'ing user-supplied dylibs. Under the hardened
  runtime, the default library-validation policy would refuse to load any dylib
  not signed by the same Team ID, which would break every third-party plugin.
  `disable-library-validation` lifts exactly that restriction. The JIT / unsigned-
  executable-memory entitlements cover WKWebView's JavaScriptCore JIT and wgpu/
  Metal shader compilation.

  These are only consumed when the bundle is code-signed (see tauri.bundle.conf.json
  → bundle.macOS.entitlements). Signing itself is gated on an Apple Developer
  Program membership + Developer ID cert (documented in docs/RELEASING.md).
-->
<plist version="1.0">
<dict>
  <!-- Load third-party CLAP/LV2/OFX plugin dylibs that aren't signed by us. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- WKWebView JavaScriptCore JIT + wgpu/Metal shader JIT. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Some plugin SDKs resolve dependencies via DYLD_* env vars. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
