# Vance accounts service — configuration. Copy to `.env` and adjust.
# All values have safe local-dev defaults, so `cargo run` works with NONE of
# these set. You only need the provider blocks to enable REAL sign-in.

# Where the service listens.
VANCE_ACCOUNTS_ADDR=127.0.0.1:8787

# SQLite database file (created on first run).
VANCE_ACCOUNTS_DB=vance-accounts.db

# Ed25519 signing key for access tokens. If unset, a key is generated and
# persisted to this path on first run (dev convenience). In production, mount
# a real secret and set this to its path.
VANCE_ACCOUNTS_SIGNING_KEY=signing_key.bin

# Public base URL the desktop client + providers redirect back to. In dev the
# client talks to http://127.0.0.1:8787 directly.
VANCE_ACCOUNTS_PUBLIC_URL=http://127.0.0.1:8787

# The built-in `dev` provider simulates OAuth locally with no external calls,
# so the whole flow (sign-in -> session -> refresh rotation -> devices) is
# testable offline. Set to `false` to disable it in production.
VANCE_ACCOUNTS_DEV_PROVIDER=true

# ---- Real OAuth providers (each is optional; a provider is "configured"
# ---- only when its id + secret are present). See README for how to create
# ---- each developer app and what redirect URI to register.

# GitHub OAuth App (redirect: {PUBLIC_URL}/auth/callback?provider=github)
# VANCE_GITHUB_CLIENT_ID=
# VANCE_GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 Web client (redirect: {PUBLIC_URL}/auth/callback?provider=google)
# VANCE_GOOGLE_CLIENT_ID=
# VANCE_GOOGLE_CLIENT_SECRET=

# Sign in with Apple (redirect: {PUBLIC_URL}/auth/callback?provider=apple)
# Apple uses a client secret that is itself a signed JWT — see README.
# VANCE_APPLE_CLIENT_ID=
# VANCE_APPLE_CLIENT_SECRET=

# Meta / Facebook Login (redirect: {PUBLIC_URL}/auth/callback?provider=meta)
# VANCE_META_CLIENT_ID=
# VANCE_META_CLIENT_SECRET=
